<dashboard version="1.1">
  <label>Security Alerts</label>
  
  <!-- Filters -->
  <fieldset submitButton="false">
    <input type="time" token="time_range" searchWhenChanged="true">
      <label>Tijdvenster:</label>
      <default>
        <earliestTime>-24h@h</earliestTime>
        <latestTime>now</latestTime>
      </default>
    </input>
    <input type="dropdown" token="severity_filter" searchWhenChanged="true">
      <label>Severity:</label>
      <choice value="*">All</choice>
      <choice value="critical">Critical</choice>
      <choice value="high">High</choice>
      <choice value="medium">Medium</choice>
      <choice value="low">Low</choice>
      <default>*</default>
    </input>
    <input type="text" token="src_ip_filter" searchWhenChanged="true">
      <label>Source IP:</label>
      <default>*</default>
    </input>
  </fieldset>
  
  <!-- KPI Row -->
  <row>
    <panel>
      <title>Total Alerts</title>
      <single>
        <searchString>`soc_analyst` severity=$severity_filter$ src_ip=$src_ip_filter$ | stats count</searchString>
        <earliest>-24h@h</earliest>
        <latest>now</latest>
        <option name="colorMode">block</option>
        <option name="numberPrecision">0</option>
      </single>
    </panel>
    <panel>
      <title>Critical Alerts</title>
      <single>
        <searchString>`soc_analyst` severity=critical src_ip=$src_ip_filter$ | stats count</searchString>
        <earliest>-24h@h</earliest>
        <latest>now</latest>
        <option name="colorMode">block</option>
        <option name="numberPrecision">0</option>
        <option name="rangeColors">["0x53a051","0xf1813f","0xdc4a4a"]</option>
        <option name="rangeValues">[0,1,5]</option>
      </single>
    </panel>
    <panel>
      <title>High Alerts</title>
      <single>
        <searchString>`soc_analyst` severity=high src_ip=$src_ip_filter$ | stats count</searchString>
        <earliest>-24h@h</earliest>
        <latest>now</latest>
        <option name="colorMode">block</option>
        <option name="numberPrecision">0</option>
        <option name="rangeColors">["0x53a051","0xf1813f","0xdc4a4a"]</option>
        <option name="rangeValues">[0,5,10]</option>
      </single>
    </panel>
    <panel>
      <title>Unique Sources</title>
      <single>
        <searchString>`soc_analyst` src_ip=$src_ip_filter$ | stats dc(src_ip) as count</searchString>
        <earliest>-24h@h</earliest>
        <latest>now</latest>
        <option name="colorMode">block</option>
        <option name="numberPrecision">0</option>
      </single>
    </panel>
  </row>
  
  <row>
    <panel>
      <title>Top Security Alerts (last 24h)</title>
      <chart>
        <searchString>`soc_analyst` severity=$severity_filter$ src_ip=$src_ip_filter$ | stats count by severity</searchString>
        <earliest>-24h@h</earliest>
        <latest>now</latest>
      </chart>
    </panel>
    <panel>
      <title>Alert Count by Index</title>
      <table>
        <searchString>`soc_analyst` severity=$severity_filter$ src_ip=$src_ip_filter$ | stats count by index</searchString>
        <earliest>-24h@h</earliest>
        <latest>now</latest>
      </table>
    </panel>
  </row>
  <row>
    <panel>
      <title>Recent Security Events</title>
      <table>
        <searchString>`soc_analyst` severity=$severity_filter$ src_ip=$src_ip_filter$ | sort - _time | head 20</searchString>
        <earliest>-24h@h</earliest>
        <latest>now</latest>
      </table>
    </panel>
  </row>
</dashboard>

<dashboard>
  <label>Network Monitoring</label>
  
  <!-- Time range input -->
  <fieldset submitButton="false">
    <input type="time" token="time_range" searchWhenChanged="true">
      <label>Tijdvenster:</label>
      <default>
        <earliestTime>-24h@h</earliestTime>
        <latestTime>now</latestTime>
      </default>
    </input>
  </fieldset>
  
  <!-- KPI Row -->
  <row>
    <panel>
      <title>Total Connections</title>
      <single>
        <searchString>`soc_network` | stats count</searchString>
        <earliest>$time_range.earliest$</earliest>
        <latest>$time_range.latest$</latest>
        <option name="colorMode">block</option>
        <option name="numberPrecision">0</option>
      </single>
    </panel>
    <panel>
      <title>Unique Src IPs</title>
      <single>
        <searchString>`soc_network` | stats dc(src_ip) as count</searchString>
        <earliest>$time_range.earliest$</earliest>
        <latest>$time_range.latest$</latest>
        <option name="colorMode">block</option>
        <option name="numberPrecision">0</option>
      </single>
    </panel>
    <panel>
      <title>Unique Dest IPs</title>
      <single>
        <searchString>`soc_network` | stats dc(dest_ip) as count</searchString>
        <earliest>$time_range.earliest$</earliest>
        <latest>$time_range.latest$</latest>
        <option name="colorMode">block</option>
        <option name="numberPrecision">0</option>
      </single>
    </panel>
    <panel>
      <title>Bytes Transferred (MB)</title>
      <single>
        <searchString>`soc_network` | stats sum(bytes_out) as bytes | eval mb=round(bytes/1048576,2)</searchString>
        <earliest>$time_range.earliest$</earliest>
        <latest>$time_range.latest$</latest>
        <option name="colorMode">block</option>
        <option name="numberPrecision">0.00</option>
      </single>
    </panel>
  </row>
  
  <row>
    <panel>
      <title>Top Source IPs</title>
      <table>
        <searchString>`soc_network` | stats count by src_ip | sort - count</searchString>
        <earliest>$time_range.earliest$</earliest>
        <latest>$time_range.latest$</latest>
      </table>
    </panel>
    <panel>
      <title>Top Destinations</title>
      <table>
        <searchString>`soc_network` | stats count by dest_ip | sort - count</searchString>
        <earliest>$time_range.earliest$</earliest>
        <latest>$time_range.latest$</latest>
      </table>
    </panel>
  </row>
</dashboard>

<dashboard version="1.1">
  <label>Network Monitoring</label>
  
  <!-- Filters -->
  <fieldset submitButton="false">
    <input type="time" token="time_range" searchWhenChanged="true">
      <label>Tijdvenster:</label>
      <default>
        <earliestTime>-24h@h</earliestTime>
        <latestTime>now</latestTime>
      </default>
    </input>
    <input type="text" token="src_ip_filter" searchWhenChanged="true">
      <label>Source IP:</label>
      <default>*</default>
    </input>
    <input type="text" token="dest_ip_filter" searchWhenChanged="true">
      <label>Destination IP:</label>
      <default>*</default>
    </input>
  </fieldset>
  
  <!-- KPI Row -->
  <row>
    <panel>
      <title>Total Connections</title>
      <single>
        <searchString>`soc_network` src_ip=$src_ip_filter$ dest_ip=$dest_ip_filter$ | stats count</searchString>
        <earliest>-24h@h</earliest>
        <latest>now</latest>
        <option name="colorMode">block</option>
        <option name="numberPrecision">0</option>
      </single>
    </panel>
    <panel>
      <title>Unique Src IPs</title>
      <single>
        <searchString>`soc_network` src_ip=$src_ip_filter$ dest_ip=$dest_ip_filter$ | stats dc(src_ip) as count</searchString>
        <earliest>-24h@h</earliest>
        <latest>now</latest>
        <option name="colorMode">block</option>
        <option name="numberPrecision">0</option>
      </single>
    </panel>
    <panel>
      <title>Unique Dest IPs</title>
      <single>
        <searchString>`soc_network` src_ip=$src_ip_filter$ dest_ip=$dest_ip_filter$ | stats dc(dest_ip) as count</searchString>
        <earliest>-24h@h</earliest>
        <latest>now</latest>
        <option name="colorMode">block</option>
        <option name="numberPrecision">0</option>
      </single>
    </panel>
    <panel>
      <title>Bytes Transferred (MB)</title>
      <single>
        <searchString>`soc_network` src_ip=$src_ip_filter$ dest_ip=$dest_ip_filter$ | stats sum(bytes_out) as bytes | eval mb=round(bytes/1048576,2)</searchString>
        <earliest>-24h@h</earliest>
        <latest>now</latest>
        <option name="colorMode">block</option>
        <option name="numberPrecision">0.00</option>
      </single>
    </panel>
  </row>
  
  <row>
    <panel>
      <title>Top Source IPs</title>
      <table>
        <searchString>`soc_network` src_ip=$src_ip_filter$ dest_ip=$dest_ip_filter$ | stats count by src_ip | sort - count</searchString>
        <earliest>-24h@h</earliest>
        <latest>now</latest>
      </table>
    </panel>
    <panel>
      <title>Top Destinations</title>
      <table>
        <searchString>`soc_network` src_ip=$src_ip_filter$ dest_ip=$dest_ip_filter$ | stats count by dest_ip | sort - count</searchString>
        <earliest>-24h@h</earliest>
        <latest>now</latest>
      </table>
    </panel>
  </row>
</dashboard>

<dashboard>
  <label>Authentication Monitoring</label>
  
  <!-- Time range input -->
  <fieldset submitButton="false">
    <input type="time" token="time_range" searchWhenChanged="true">
      <label>Tijdvenster:</label>
      <default>
        <earliestTime>-24h@h</earliestTime>
        <latestTime>now</latestTime>
      </default>
    </input>
  </fieldset>
  
  <!-- KPI Row -->
  <row>
    <panel>
      <title>Total Logins</title>
      <single>
        <searchString>`soc_auth` EventCode=4624 | stats count</searchString>
        <earliest>$time_range.earliest$</earliest>
        <latest>$time_range.latest$</latest>
        <option name="colorMode">block</option>
        <option name="numberPrecision">0</option>
      </single>
    </panel>
    <panel>
      <title>Failed Logins</title>
      <single>
        <searchString>`soc_auth` EventCode=4625 | stats count</searchString>
        <earliest>$time_range.earliest$</earliest>
        <latest>$time_range.latest$</latest>
        <option name="colorMode">block</option>
        <option name="numberPrecision">0</option>
        <option name="rangeColors">["0x53a051","0xf1813f","0xdc4a4a"]</option>
        <option name="rangeValues">[10,50]</option>
      </single>
    </panel>
    <panel>
      <title>Unique Users</title>
      <single>
        <searchString>`soc_auth` | stats dc(user) as count</searchString>
        <earliest>$time_range.earliest$</earliest>
        <latest>$time_range.latest$</latest>
        <option name="colorMode">block</option>
        <option name="numberPrecision">0</option>
      </single>
    </panel>
    <panel>
      <title>Locked Accounts</title>
      <single>
        <searchString>`soc_auth` EventCode=4740 | stats count</searchString>
        <earliest>$time_range.earliest$</earliest>
        <latest>$time_range.latest$</latest>
        <option name="colorMode">block</option>
        <option name="numberPrecision">0</option>
        <option name="rangeColors">["0x53a051","0xdc4a4a"]</option>
        <option name="rangeValues">[1]</option>
      </single>
    </panel>
  </row>
  
  <row>
    <panel>
      <title>Failed Logins - Top Users</title>
      <table>
        <searchString>`soc_auth` EventCode=4625 | stats count by user | sort - count</searchString>
        <earliest>$time_range.earliest$</earliest>
        <latest>$time_range.latest$</latest>
      </table>
    </panel>
    <panel>
      <title>Successful Logins - Last 24h</title>
      <table>
        <searchString>`soc_auth` EventCode=4624 | stats count by user | sort - count</searchString>
        <earliest>$time_range.earliest$</earliest>
        <latest>$time_range.latest$</latest>
      </table>
    </panel>
  </row>
  <row>
    <panel>
      <title>Failed Login Trend</title>
      <chart>
        <searchString>`soc_auth` EventCode=4625 | timechart span=1h count</searchString>
        <earliest>$time_range.earliest$</earliest>
        <latest>$time_range.latest$</latest>
      </chart>
    </panel>
  </row>
</dashboard>
